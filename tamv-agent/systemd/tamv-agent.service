[Unit]
Description=TAMV sovereign mesh agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tamv
Group=tamv
ExecStart=/usr/local/bin/tamv-agent --config /etc/tamv/config.toml --state /var/lib/tamv/state.json
Restart=on-failure
RestartSec=3s
LimitNOFILE=65535
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/tamv
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target